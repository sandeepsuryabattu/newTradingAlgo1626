# Kotak Neo (per official SDK)
# consumer_key: token from Neo app/web Trade API card (invest tab -> trade api card)
# access_token: optional session token (if already generated); otherwise leave blank and login via SDK
# neo_fin_key: optional; pass None/blank unless provided
# environment: prod or test (if test exists)
# mobile_number/ucc/mpin/totp_secret: for automating TOTP login (country code with mobile_number)
CONSUMER_KEY=
ACCESS_TOKEN=
NEO_FIN_KEY=
ENVIRONMENT=prod
MOBILE_NUMBER=
UCC=
MPIN=
TOTP_SECRET=

# Instruments
SENSEX_INSTRUMENT_TOKEN=
SENSEX_EXCHANGE_SEGMENT=bse_cm
SENSEX_SYMBOL=SENSEX
SCRIP_MASTER_PATH=
SCRIP_MASTER_URL=https://developers.kotaksecurities.com/scrip-master
AUTO_REFRESH_TOKEN=true

# Telegram (optional; leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite (local, no install)
SQLITE_PATH=storage.db

# Mode and defaults
TRADING_MODE=paper
TZ=Asia/Kolkata
LOTS_DEFAULT=1
